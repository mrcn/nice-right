# ─── Digital Footprint Scanner (fn-16) ────────────────────────────────
# Copy to `.env.local` for local dev; set the same keys in Vercel →
# Project Settings → Environment Variables for preview/production.
# NEVER commit real values. Secrets must NOT use the NEXT_PUBLIC_ prefix
# except the Turnstile site key, which is public by design.

# Google PageSpeed Insights — server-side scan signal provider.
PAGESPEED_API_KEY=

# Cloudflare Turnstile — bot protection on /api/scan and /api/lead.
# Site key is embedded client-side (public); secret stays server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — transactional email for the full scan report.
RESEND_API_KEY=

# DataForSEO — Google Business Profile live lookup.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Upstash Redis — scan result cache + shared rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mailchimp — marketing list subscribe (only with explicit consent).
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=
